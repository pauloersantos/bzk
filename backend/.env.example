# Este arquivo contém somente nomes e exemplos não secretos.
# Produção deve usar config/runtime.env.encrypted e chave mestra externa.
NODE_ENV=development
PORT=3100
API_PREFIX=api/v1
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/DATABASE
JWT_SECRET=SUBSTITUIR_POR_SEGREDO_FORTE
JWT_ISSUER=bomzeika-obras
JWT_AUDIENCE=bomzeika-obras-api
JWT_TTL_SECONDS=3600
CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_DEFAULT=120
RATE_LIMIT_AUTH=10
LOG_LEVEL=info
DEV_USER_ID=00000000-0000-4000-8000-000000000001
DEV_ORGANIZATION_ID=00000000-0000-4000-8000-000000000001
